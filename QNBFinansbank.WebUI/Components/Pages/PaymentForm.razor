@page "/"
@page "/payment-form"

<EditForm Model="@paymentRequestData" OnValidSubmit="HandleValidSubmit">
    <div class="container">
        <h2 class="mt-4">Payment Request Form</h2>
        <div class="card mt-4">
            <div class="card-header">Account Information</div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="MbrId" class="form-label">Member ID</label>
                    <InputText id="MbrId" class="form-control" @bind-Value="paymentRequestData.Account.MbrId" />
                </div>
                <div class="mb-3">
                    <label for="MerchantId" class="form-label">Merchant ID</label>
                    <InputText id="MerchantId" class="form-control" @bind-Value="paymentRequestData.Account.MerchantId" />
                </div>
                <div class="mb-3">
                    <label for="MerchantPass" class="form-label">Merchant Password</label>
                    <InputText id="MerchantPass" class="form-control" @bind-Value="paymentRequestData.Account.MerchantPass" />
                </div>
                <div class="mb-3">
                    <label for="UserCode" class="form-label">User Code</label>
                    <InputText id="UserCode" class="form-control" @bind-Value="paymentRequestData.Account.UserCode" />
                </div>
                <div class="mb-3">
                    <label for="UserPass" class="form-label">User Pass</label>
                    <InputText id="UserPass" class="form-control" @bind-Value="paymentRequestData.Account.UserPass" />
                </div>
                <div class="mb-3">
                    <label for="SecureType" class="form-label">Secure Type</label>
                    <InputSelect id="SecureType" class="form-control" @bind-Value="paymentRequestData.Account.SecureType">
                        <option value="">Select Secure Type</option>
                        <option value="NonSecure">NonSecure</option>
                        <option value="3DPay">3DPay</option>
                        <option value="3DModel">3DModel</option>
                        <option value="3DPayHosting">3DPayHosting</option>
                        <option value="Report">Report</option>
                        <option value="Inquiry">Inquiry</option>
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label for="TxnType" class="form-label">TxnType</label>
                    <InputText id="TxnType" class="form-control" @bind-Value="paymentRequestData.Account.TxnType" />
                </div>
                <div class="mb-3">
                    <label for="BaseUrl" class="form-label">BaseUrl</label>
                    <InputText id="BaseUrl" class="form-control" @bind-Value="paymentRequestData.Account.BaseUrl" />
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">Order Information</div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="Installment" class="form-label">Installment</label>
                    <InputText id="Installment" class="form-control" @bind-Value="paymentRequestData.Order.Installment" />
                </div>
                <div class="mb-3">
                    <label for="Currency" class="form-label">Currency</label>
                    <InputText id="Currency" class="form-control" @bind-Value="paymentRequestData.Order.Currency" />
                </div>
                <div class="mb-3">
                    <label for="ReturnUrl" class="form-label">Return URL</label>
                    <InputText id="ReturnUrl" class="form-control" @bind-Value="paymentRequestData.Order.ReturnUrl" />
                </div>
                <div class="mb-3">
                    <label for="OrderId" class="form-label">Order Id</label>
                    <div class="input-group">
                        <InputText id="OrderId" class="form-control" @bind-Value="paymentRequestData.Order.OrderId" readonly="@isOrderIdReadonly" />
                        <button type="button" class="btn btn-secondary" @onclick="GenerateRandomOrderId">Generate</button>
                    </div>
                </div>
                <div class="mb-3">
                    <label for="Amount" class="form-label">Amount</label>
                    <InputText id="Amount" class="form-control" @bind-Value="paymentRequestData.Order.Amount" />
                </div>
                <div class="mb-3">
                    <label for="Language" class="form-label">Language</label>
                    <InputText id="Language" class="form-control" @bind-Value="paymentRequestData.Order.Language" />
                </div>
                <div class="mb-3">
                    <label for="PaymentSecurity" class="form-label">Payment Security</label>
                    <InputSelect id="SecureType" class="form-control" @bind-Value="paymentRequestData.Order.PaymentSecurity">
                        <option value="false">NonSecure</option>
                        <option value="true" selected="selected">3D</option>
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label for="Random" class="form-label">Random</label>
                    <div class="input-group">
                        <InputText id="Random" class="form-control" @bind-Value="paymentRequestData.Order.Random" readonly="@isRandomReadonly" />
                        <button type="button" class="btn btn-secondary" @onclick="GenerateRandomValue">Generate</button>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">Card Information</div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="CardNo" class="form-label">Card Number</label>
                    <InputText id="CardNo" class="form-control" @bind-Value="paymentRequestData.Card.CardNo" />
                </div>
                <div class="mb-3">
                    <label for="CardHolderName" class="form-label">Card Holder Name</label>
                    <InputText id="CardHolderName" class="form-control" @bind-Value="paymentRequestData.Card.CardHolderName" />
                </div>
                <div class="mb-3">
                    <label for="CVC" class="form-label">CVC</label>
                    <InputText id="CVC" class="form-control" @bind-Value="paymentRequestData.Card.CVC" />
                </div>
                <div class="mb-3">
                    <label for="ExpireMonth" class="form-label">Expire Month</label>
                    <InputText id="ExpireMonth" class="form-control" @bind-Value="paymentRequestData.Card.ExpireMonth" />
                </div>
                <div class="mb-3">
                    <label for="ExpireYear" class="form-label">Expire Year</label>
                    <InputText id="ExpireYear" class="form-control" @bind-Value="paymentRequestData.Card.ExpireYear" />
                </div>
                <div class="mb-3">
                    <label for="Email" class="form-label">Email</label>
                    <InputText id="Email" class="form-control" @bind-Value="paymentRequestData.Card.Email" />
                </div>
            </div>
        </div>

        <div class="card mt-4">
            <div class="card-header">Submerchant Information</div>
            <div class="card-body">
                <div class="mb-3">
                    <label for="SubmerchantId" class="form-label">Submerchant ID</label>
                    <InputText id="SubmerchantId" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubmerchantIdCode" />
                </div>
                <div class="mb-3">
                    <label for="SubmerchantName" class="form-label">Submerchant Name</label>
                    <InputText id="SubmerchantName" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubmerchantName" />
                </div>
                <div class="mb-3">
                    <label for="SubmerchantIn" class="form-label">Submerchant TCKN/VKN</label>
                    <InputText id="SubmerchantIn" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubMerchantIn" />
                </div>
                <div class="mb-3">
                    <label for="SubMerchantUrl" class="form-label">Submerchant MCC URL</label>
                    <InputText id="SubMerchantUrl" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubMerchantUrl" />
                </div>
                <div class="mb-3">
                    <label for="SubMerchantNumber" class="form-label">Submerchant Number</label>
                    <InputText id="SubMerchantNumber" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubMerchantNumber" />
                </div>
                <div class="mb-3">
                    <label for="SubMerchantBddkCode" class="form-label">Submerchant BDDK Code</label>
                    <InputText id="SubMerchantBddkCode" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubMerchantBddkCode" />
                </div>
                <div class="mb-3">
                    <label for="SubMerchantMcc" class="form-label">Submerchant MCC</label>
                    <InputText id="SubMerchantMcc" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubMerchantMcc" />
                </div>
                <div class="mb-3">
                    <label for="SubMerchantCity" class="form-label">Submerchant City</label>
                    <InputText id="SubMerchantCity" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubMerchantCity" />
                </div>
                <div class="mb-3">
                    <label for="SubMerchantPostalCode" class="form-label">Submerchant Postal Code</label>
                    <InputText id="SubMerchantPostalCode" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubMerchantPostalCode" />
                </div>
                <div class="mb-3">
                    <label for="SubMerchantCountry" class="form-label">Submerchant Country</label>
                    <InputText id="SubMerchantCountry" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubMerchantCountry" />
                </div>
                <div class="mb-3">
                    <label for="SubMerchantOrganizationId" class="form-label">Submerchant Organization ID</label>
                    <InputText id="SubMerchantOrganizationId" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubMerchantOrganizationId" />
                </div>
                <div class="mb-3">
                    <label for="SubMerchantFacilicatorId" class="form-label">Submerchant Facilicator ID</label>
                    <InputText id="SubMerchantFacilicatorId" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubMerchantFacilicatorId" />
                </div>
                <div class="mb-3">
                    <label for="SubMerchantTerminalNo" class="form-label">Submerchant Terminal No</label>
                    <InputText id="SubMerchantTerminalNo" class="form-control" @bind-Value="paymentRequestData.Submerchant.SubMerchantTerminalNo" />
                </div>
            </div>
        </div>

        <button type="submit" class="btn btn-primary mt-4">Submit Payment</button>
    </div>
</EditForm>

<!-- Başarısız Ödeme Modalı -->
<div class="modal fade @modalClass" tabindex="-1" role="dialog" style="display:@modalDisplay;">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">@title</h5>
                <button type="button" class="btn-close" @onclick="CloseModal"></button>
            </div>
            <div class="modal-body">
                <p>@message</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" @onclick="CloseModal">Close</button>
                @if (!string.IsNullOrEmpty(redirectUrl))
                {
                    <button type="button" class="btn btn-success" @onclick="RedirectToPaymentUrl">Redirect</button>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private PaymentRequestDto paymentRequestData = new PaymentRequestDto
        {
            Account = new AccountDto(),
            Order = new OrderDto(),
            Card = new CardDto(),
            Submerchant = new SubmerchantDto()
        };

    private string modalClass = "";
    private string modalDisplay = "none";
    private string title = "";
    private string message = "";
    private string? redirectUrl = "";

    private bool isOrderIdReadonly = false;
    private bool isRandomReadonly = false;

    private void HandleValidSubmit()
    {
        var response = VirtualPos.Payment(paymentRequestData);

        if (response != null && response.Result != null && response.Payment != null && response.Result.Result)
        {
            title = "Ödeme başarılı";
            redirectUrl = response.Payment.URL; // Ödeme başarılıysa yönlendirme URL'sini al
        }
        else
        {
            title = "Ödeme başarısız";
        }
        message = response?.Result?.ResultMessage ?? "An unknown error occurred.";
        ShowModal();
    }

    private void RedirectToPaymentUrl()
    {
        if (!string.IsNullOrEmpty(redirectUrl))
        {
            Navigation.NavigateTo($"/payment-redirect?htmlContent={Uri.EscapeDataString(redirectUrl)}");
        }
    }

    private void GenerateRandomOrderId()
    {
        paymentRequestData.Order.OrderId = new Random().Next(1, 99999).ToString();
        isOrderIdReadonly = true;
    }

    private void GenerateRandomValue()
    {
        paymentRequestData.Order.Random = Guid.NewGuid().ToString("N").Substring(0, 8);
        isRandomReadonly = true;
    }

    private void ShowModal()
    {
        modalClass = "show";
        modalDisplay = "block";
        StateHasChanged();
    }

    private void CloseModal()
    {
        modalClass = "";
        modalDisplay = "none";
        StateHasChanged();
    }
}
