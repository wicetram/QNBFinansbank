@page "/callback"

@attribute [IgnoreAntiforgeryToken]

@inject IHttpContextAccessor httpContextAccessor

@model QNBFinansbank.WebUI.Components.Pages.Callback.CallbackModel
@{
    ViewData["Title"] = "Testsite";
}

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Error</title>
    <link href="~/bootstrap/bootstrap.min.css" rel="stylesheet" />
    <link href="~/app.css" rel="stylesheet" asp-append-version="true" />
</head>

<body>
    <div class="main">
        <div class="content px-4">
            <h1>Form Values</h1>
            <table>
                @foreach (var key in HttpContext.Request.Form.Keys)
                {
                    <tr>
                        <td>@key</td>
                        <td>@HttpContext.Request.Form[key].ToString()</td>
                    </tr>
                }
            </table>
        </div>
    </div>
</body>